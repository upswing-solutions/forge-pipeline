# ─────────────────────────────────────────────────────────────────────────────
# FORGE pipeline — environment template
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# This reference ships with stubbed external adapters, so most keys are only
# needed once you wire a real implementation in src/shared/adapters/.
# ─────────────────────────────────────────────────────────────────────────────

# --- Temporal (orchestration) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=forge-pipeline

# --- Postgres (business data — source of truth) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=

# --- LLM: analytical work (research synthesis, scoring, QA) ---
# Used by src/shared/lib/gemini.ts. Any JSON-capable model provider works.
GEMINI_API_KEY=

# --- LLM: creative work (agents HATTORI / HANZO / BARD) ---
# The creative agents shell out to the `claude` CLI (subscription auth via
# keychain/OAuth), so no API key is required here by default. Set this only if
# you swap runClaudeMax() for a direct API call.
# ANTHROPIC_API_KEY=

# --- External services (only needed when you replace the stub adapters) ---
# Prospect discovery / scraping
SCRAPER_API_TOKEN=
# Deep research
RESEARCH_API_KEY=
# Transactional email
EMAIL_API_KEY=
EMAIL_FROM=
# Payments
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Image CDN
CDN_CLOUD_NAME=
CDN_API_KEY=
CDN_API_SECRET=
# Preview hosting / blob storage
BLOB_READ_WRITE_TOKEN=
# Operator notifications (e.g. a chat webhook)
NOTIFY_WEBHOOK_URL=
