{
  "name": "forge-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "A durable, agentic pipeline that discovers local-business prospects, builds them a spec website with an LLM, and runs outreach — orchestrated with Temporal. Sanitized architecture reference.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "worker": "ts-node --transpile-only --require dotenv/config src/workers/worker.ts",
    "start": "ts-node --require dotenv/config src/client.ts",
    "temporal": "temporal server start-dev"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@temporalio/activity": "^1.15.0",
    "@temporalio/client": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@temporalio/workflow": "^1.15.0",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
}
